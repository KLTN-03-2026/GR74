# Client URL
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URL=mongodb://<username>:<password>@<cluster-url>:27017/<database>?ssl=true&replicaSet=<replicaSet>&authSource=admin

# Redis
REDIS_URL=redis-<id>.<region>.ec2.cloud.redislabs.com:<port>
REDIS_HOST=redis-<id>.<region>.ec2.cloud.redislabs.com
REDIS_PORT=<port>
REDIS_USER=default
REDIS_PASSWORD=<your_redis_password>

# OpenAI
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_MODEL=gpt-4o-mini

# JWT Tokens
ACCESS_TOKEN_SECRET=<your_access_token_secret>
REFRESH_TOKEN_SECRET=<your_refresh_token_secret>

# SMTP mail for forgot password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your_smtp_user>
SMTP_PASS=<your_smtp_password>
MAIL_FROM=<your_mail_from>

# Stripe test checkout for Premium plan
STRIPE_SECRET_KEY=<your_stripe_secret_key>
